# Production environment template for the Laravel API container.
# Copy to .env on the host, or set these as environment variables in the
# hosting dashboard (Railway / Render / Fly.io / cPanel).

APP_NAME=SmartStay
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://your-api-host.example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL is required: RoomController uses MySQL's TIMESTAMP(a, b) function.
# SQLite will fail with "no such function: TIMESTAMP".
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# These three all use the database, so a reachable MySQL must exist.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum/CORS: the deployed frontend origin.
FRONTEND_URL=https://smartstay-ai.vercel.app
SANCTUM_STATEFUL_DOMAINS=smartstay-ai.vercel.app

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Optional: chatbot feature.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
