# Reference only: add these as Koyeb environment variables.
# Never commit real credentials or your real APP_KEY to GitHub.
APP_NAME=SmartStay
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY_USING_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://YOUR-KOYEB-SERVICE.koyeb.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# TiDB Cloud (MySQL-compatible)
DB_CONNECTION=mysql
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_DATABASE=YOUR_TIDB_DATABASE
DB_USERNAME=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Avoid relying on ephemeral-container database tables for cache/session/queue.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Optional AI chatbot integration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_ORGANIZATION=
